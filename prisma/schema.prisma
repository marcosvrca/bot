generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config             TenantConfig?
  sessions           ConversationSession[]
  messages           MessageLog[]
  appointments       Appointment[]
  googleAppointments GoogleAppointment[]
  leads              Lead[]
  catalogItems       CatalogItem[]
}

model TenantConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  evolutionInstance   String   @unique
  activeModels        String[] @default(["menu"])
  defaultModel        String   @default("menu")
  menuFlow            Json?
  /// Webhook opcional: POST JSON do lead criado (CRM, Sheets, Make, n8n…).
  leadsWebhookUrl     String?
  /// Celulares do dono (só dígitos). Podem gerenciar o bot pelo WhatsApp sem painel.
  ownerPhones         String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([evolutionInstance])
}

/// Lead capturado pelo modelo `leads` (CRM básico).
model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  name      String
  email     String?
  interest  String?
  city      String?
  origin    String   @default("whatsapp")
  status    String   @default("new")
  notes     String?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, phone])
  @@index([tenantId, status])
}

/// Item do catálogo (modelo `catalog`).
model CatalogItem {
  id          String   @id @default(cuid())
  tenantId    String
  sku         String?
  name        String
  description String?
  /// Preço em centavos (BRL). Ex.: 48900 = R$ 489,00
  priceCents  Int
  category    String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, sortOrder])
  @@index([tenantId, category])
  @@index([tenantId, name])
}

model ConversationSession {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  model     String
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId, updatedAt])
}

model MessageLog {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  direction String
  body      String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([phone, createdAt])
}

model Appointment {
  id                  String    @id @default(cuid())
  tenantId            String
  phone               String
  title               String
  description         String?
  scheduledAt         DateTime
  remindBeforeMinutes Int       @default(60)
  remindAt            DateTime
  reminderSentAt      DateTime?
  status              String    @default("scheduled")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone, status, scheduledAt])
  @@index([status, remindAt, reminderSentAt])
}

/// Compromissos do modelo scheduling-google (espelhados no Google Calendar).
model GoogleAppointment {
  id                  String    @id @default(cuid())
  tenantId            String
  phone               String
  title               String
  description         String?
  scheduledAt         DateTime
  endsAt              DateTime
  remindBeforeMinutes Int       @default(60)
  remindAt            DateTime
  reminderSentAt      DateTime?
  status              String    @default("scheduled")
  googleEventId       String
  googleCalendarId    String    @default("primary")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, googleEventId])
  @@index([tenantId, phone, status, scheduledAt])
  @@index([status, remindAt, reminderSentAt])
}
