generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config       TenantConfig?
  sessions     ConversationSession[]
  messages     MessageLog[]
  appointments       Appointment[]
  googleAppointments GoogleAppointment[]
}

model TenantConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  evolutionInstance   String   @unique
  activeModels        String[] @default(["menu"])
  defaultModel        String   @default("menu")
  menuFlow            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([evolutionInstance])
}

model ConversationSession {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  model     String
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([tenantId, updatedAt])
}

model MessageLog {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String
  direction String
  body      String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([phone, createdAt])
}

model Appointment {
  id                  String    @id @default(cuid())
  tenantId            String
  phone               String
  title               String
  description         String?
  scheduledAt         DateTime
  remindBeforeMinutes Int       @default(60)
  remindAt            DateTime
  reminderSentAt      DateTime?
  status              String    @default("scheduled")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone, status, scheduledAt])
  @@index([status, remindAt, reminderSentAt])
}

/// Compromissos do modelo scheduling-google (espelhados no Google Calendar).
model GoogleAppointment {
  id                  String    @id @default(cuid())
  tenantId            String
  phone               String
  title               String
  description         String?
  scheduledAt         DateTime
  endsAt              DateTime
  remindBeforeMinutes Int       @default(60)
  remindAt            DateTime
  reminderSentAt      DateTime?
  status              String    @default("scheduled")
  googleEventId       String
  googleCalendarId    String    @default("primary")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, googleEventId])
  @@index([tenantId, phone, status, scheduledAt])
  @@index([status, remindAt, reminderSentAt])
}
