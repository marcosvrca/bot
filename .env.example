# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (bot)
DATABASE_URL=postgresql://bot:bot_secret@localhost:5433/bot?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Evolution API
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-api-key-32chars

# Webhook security (header x-webhook-secret)
WEBHOOK_SECRET=change-me-webhook-secret-min-16

# Session & rate limit
SESSION_TTL_SECONDS=1800
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Demo tenant / instance (must match Evolution instance name)
DEMO_TENANT_SLUG=demo
DEMO_EVOLUTION_INSTANCE=demo
# Active bot for demo: menu | scheduling | clinic
DEMO_DEFAULT_MODEL=clinic
REMINDER_POLL_MS=30000

# Clínica de psicologia (Documents/Marcos/clinica-psicologia)
CLINIC_API_URL=http://localhost:4000
CLINIC_API_KEY=clinic-api-key-change-me-16
